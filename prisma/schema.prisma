// ORYXX Prisma schema — PostgreSQL (Neon).
// Auth: User + Waitlist. Sessions are JWT (Credentials provider), so no
// Prisma adapter / Session model needed — keeps it lean. OAuth models can be
// added later without migration pain.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")      // pooled connection string (runtime)
  directUrl = env("DIRECT_URL")          // direct connection string (migrations)
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String? // null for future OAuth-only users
  role         String   @default("user") // user | admin | demo-rider | demo-driver | demo-shipper | demo-fleet
  status       String   @default("active") // active | suspended
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
}

model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      String   @default("user") // requested role at signup
  status    String   @default("pending") // pending | approved | rejected
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// Willingness field-experiment: stores real provider responses to pooled-trip
// offers. This produces W3 (revealed acceptance) and W4 (completed execution)
// evidence. Provider identity is pseudonymous (no PII).
// RESEARCH INTEGRITY: enrollment-bound, consent-enforced, immutable preregistration.

model AcceptanceExperiment {
  id              String   @id @default(cuid())
  name            String
  description     String
  status          String   @default("DRAFT") // DRAFT | PREREGISTERED | ACTIVE | COMPLETED | ABANDONED
  // safety constraints
  maxDetourKm     Float    @default(5.0)
  maxExtraTimeMin Float    @default(20.0)
  minCompensation Float    @default(1.0)
  // preregistration (immutable after ACTIVE)
  hypothesis      String?
  population      String?
  geography       String?
  providerType    String?
  sampleTarget    Int      @default(100)
  primaryOutcome  String   @default("W3_acceptance_rate")
  secondaryOutcomes String? // JSON array
  analysisMethod  String?
  stoppingRule    String?
  randomizationSeed Int   @default(42)
  preregistrationHash String? // FULL SHA-256 of canonical design (not truncated)
  preregisteredAt String?
  // PERSISTED treatment design (the actual preregistered cells used at runtime)
  treatmentDesignJson String? // JSON of PreregisteredDesign — used at enrollment/offer time
  // economic assumptions (labelled, not observed)
  assumedUserSavings Float @default(4.0)
  assumedFailureCost Float @default(1.0)
  assumedOryxxMargin Float @default(0.50)
  // consent
  requiresConsent Boolean  @default(true)
  consentText     String?
  consentVersion  Int      @default(1)
  // relations
  enrollments     ExperimentEnrollment[]
  responses       ProviderResponse[]
  events          ExperimentEvent[]
  consents        ExperimentConsent[]

  @@index([status])
}

// Enrollment: binds a pseudonymous participant to an experiment.
// CRITICAL: The participantId is SERVER-GENERATED and bound to the
// NextAuth account email. This prevents token transfer between users.
// Enrollment requires admin verification that the participant IS a real
// transportation provider (not just any authenticated user).
model ExperimentEnrollment {
  id              String   @id @default(cuid())
  experimentId    String
  experiment      AcceptanceExperiment @relation(fields: [experimentId], references: [id])
  // server-generated pseudonymous ID (no PII)
  participantId   String   @unique
  // BINDS enrollment to a specific NextAuth account (prevents token transfer)
  accountEmail    String   // the authenticated user's email at enrollment time
  // enrollment token (used for offer authorization, short-lived)
  enrollmentToken String   @unique
  // PROVIDER VERIFICATION: must be set by admin before offers. Level is explicit.
  providerVerified String  @default("unverified") // unverified | operator_verified | externally_verified
  providerType    String?  // taxi | fhv | truck | private
  verificationMethod String? // admin_manual | external_api | credential_check
  verificationReference String? // external reference id
  // treatment cell assigned at enrollment (immutable)
  assignedCellId  String?
  // timestamps
  enrolledAt      DateTime @default(now())
  verifiedAt      DateTime?
  withdrawnAt     DateTime?
  status          String   @default("active") // active | withdrawn
  // relations
  responses       ProviderResponse[]
  consents        ExperimentConsent[]

  @@unique([experimentId, accountEmail])
  @@index([experimentId])
  @@index([participantId])
  @@index([accountEmail])
}

// Consent: server-enforced prerequisite for participation.
// No response is accepted without a valid, non-withdrawn consent record.
// CRITICAL: consent is bound to the accountEmail, not just the enrollment token.
// This prevents user B from recording consent for user A's enrollment.
model ExperimentConsent {
  id              String   @id @default(cuid())
  experimentId    String
  experiment      AcceptanceExperiment @relation(fields: [experimentId], references: [id])
  enrollmentId    String
  enrollment      ExperimentEnrollment @relation(fields: [enrollmentId], references: [id])
  participantId   String
  // binds consent to the authenticated account (not just the token)
  accountEmail    String
  consentVersion  Int
  consentTextHash String   // full SHA-256 of consent text
  consentText     String
  consentedAt     DateTime @default(now())
  withdrawnAt     DateTime?

  @@index([experimentId])
  @@index([enrollmentId])
  @@index([accountEmail])
}

model ProviderResponse {
  id              String   @id @default(cuid())
  experimentId    String
  experiment      AcceptanceExperiment @relation(fields: [experimentId], references: [id])
  // enrollment-bound: the response must belong to an enrolled participant
  enrollmentId    String
  enrollment      ExperimentEnrollment @relation(fields: [enrollmentId], references: [id])
  // server-derived from enrollment (NOT client-supplied)
  participantId   String
  // the offer
  treatmentCellId String
  compensation    Float
  detourKm        Float
  extraTimeMin    Float
  advanceNoticeMin Float
  passengerCount  Int      @default(1)
  tripDistanceKm   Float
  originName      String
  destName        String
  hourOfDay       Int
  // state machine
  state           String   @default("OFFER_CREATED")
  decision        String?  // accept | decline | not_available | ignore
  // execution (if accepted)
  executed        Boolean?
  completed       Boolean?
  executionFailureReason String?
  // EXTERNAL VERIFICATION: W4-R requires external proof of trip completion.
  // The participant CANNOT self-report completion. An admin or system
  // must provide verification before state can transition to TRIP_COMPLETED.
  externalVerificationMethod String? // admin_verified | system_verified | gps_verified | provider_api_verified
  externalVerifiedBy String? // admin email or system id
  externalVerifiedAt DateTime?
  // completion evidence level (explicit — not collapsed)
  completionEvidenceLevel String? // none | operator | system | gps | provider_api
  // evidence tier (computed from state, NOT from client)
  evidenceTier    String   @default("NONE")
  // timing
  offerPresentedAt String?
  offerExpiresAt  String?  // offer becomes PROVIDER_IGNORED after this
  providerViewedAt String?
  decisionAt      String?
  timestamp       DateTime @default(now())

  @@index([experimentId])
  @@index([enrollmentId])
  @@index([participantId])
  @@index([state])
  @@index([evidenceTier])
}

// Append-only event log: tamper-evident application audit trail.
// Each event includes a hash chain: event_n.hash = SHA256(payload + event_{n-1}.hash)
// This is NOT cryptographically immutable (DB admin could modify), but it is
// tamper-evident at the application layer. No UPDATE or DELETE endpoint exists.
model ExperimentEvent {
  id              String   @id @default(cuid())
  experimentId    String
  experiment      AcceptanceExperiment @relation(fields: [experimentId], references: [id])
  offerId         String
  participantId   String
  fromState       String?  // null for initial creation
  toState         String
  timestamp       DateTime @default(now())
  actorType       String   // system | participant | admin
  actorId         String
  metadataHash    String
  // hash chain (tamper-evident)
  eventHash       String   // SHA256(payload + previousEventHash)
  previousEventHash String? // null for first event in chain

  @@index([experimentId])
  @@index([offerId])
}

// ═══════════════════════════════════════════════════════════════════════
// LIVE MARKETPLACE MODELS (Stage 6/7)
// ═══════════════════════════════════════════════════════════════════════
// These models are SEPARATE from the research instrument. Marketplace
// transactions have isMarketplaceOpportunity=true, researchStimulus=false.
// Sandbox/Fixture execution NEVER produces W3-M/W4-M evidence.

model TransportationDemand {
  id              String   @id @default(cuid())
  source          String   // direct-user | shipper | fleet | enterprise | api-client
  requestType     String   // rideshare | carpool | freight | transit-assisted | multimodal
  kind            String   // person | people | parcel | pallet | container
  originLat       Float
  originLon       Float
  originName      String?
  destLat         Float
  destLon         Float
  destName        String?
  windowStartSec  Int
  windowEndSec    Int
  latestArrivalSec Int
  partySize       Int
  weightKg        Float
  volumeM3        Float
  budget          Int      // minor units
  value           Int      // minor units
  priority        String   @default("normal")
  constraintsJson String?  // JSON
  status          String   @default("OPEN") // OPEN | MATCHED | IN_PROGRESS | COMPLETED | CANCELLED | EXPIRED
  externalRef     String?
  userId          String?
  environment     String   @default("SANDBOX") // FIXTURE | SANDBOX | LIVE
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  opportunities   TransportationOpportunity[]
  offers          MarketplaceOffer[]

  @@index([status])
  @@index([environment])
  @@index([userId])
}

model TransportationSupply {
  id              String   @id @default(cuid())
  providerId      String
  resourceId      String
  mode            String   // rideshare | carpool | taxi | fhv | truck | transit
  capacity        Int
  availableCapacity Int
  originLat       Float
  originLon       Float
  currentLat      Float?
  currentLon      Float?
  routeJson       String?  // JSON array of GeoPoints
  stopsJson       String?  // JSON array of GeoPoints
  departureStartSec Int
  departureEndSec Int
  availabilityStartSec Int
  availabilityEndSec Int
  costPerKm       Int      // minor units
  costPerHour     Int
  fixedCost       Int
  minimumCompensation Int
  detourToleranceKm Float
  maxDetourKm     Float
  maxExtraTimeMin Int
  status          String   @default("AVAILABLE") // AVAILABLE | RESERVED | COMMITTED | EXPIRED | OFFLINE
  source          String   // sandbox-provider | fixture-provider | etc.
  externalRef     String?
  environment     String   @default("SANDBOX")
  provenanceJson  String?  // JSON Provenance
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  opportunities   TransportationOpportunity[]

  @@index([providerId])
  @@index([status])
  @@index([environment])
}

model TransportationOpportunity {
  id              String   @id @default(cuid())
  demandId        String
  supplyId        String
  providerId      String
  routeJson       String?  // JSON
  distanceKm      Float
  estimatedTimeMin Int
  detourKm        Float
  extraTimeMin    Int
  capacityUsed    Int
  price           Int      // minor units — user price
  supplierCompensation Int
  platformFee     Int
  executionProbability Float
  confidence      Float
  status          String   @default("DISCOVERED")
  whyFeasible     String
  whyNow          String
  whyThisSupply   String
  whyOrdinaryMisses String
  isMarketplaceOpportunity Boolean @default(true)
  researchStimulus Boolean  @default(false)
  environment     String   @default("SANDBOX")
  provenanceJson  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  demand          TransportationDemand @relation(fields: [demandId], references: [id])
  supply          TransportationSupply @relation(fields: [supplyId], references: [id])
  offers          MarketplaceOffer[]
  agreement       MarketplaceAgreement?
  execution       TransportationExecution?

  @@index([demandId])
  @@index([supplyId])
  @@index([status])
  @@index([environment])
}

model MarketplaceOffer {
  id              String   @id @default(cuid())
  opportunityId   String   @unique
  demandId        String
  supplyId        String
  providerId      String
  userPrice       Int      // minor units
  supplierCompensation Int
  platformFee     Int
  expiresAt       DateTime
  status          String   @default("PENDING") // PENDING | ACCEPTED | REJECTED | EXPIRED
  isMarketplaceOpportunity Boolean @default(true)
  researchStimulus Boolean  @default(false)
  environment     String   @default("SANDBOX")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  opportunity     TransportationOpportunity @relation(fields: [opportunityId], references: [id])
  demand          TransportationDemand @relation(fields: [demandId], references: [id])
  agreement       MarketplaceAgreement?

  @@index([opportunityId])
  @@index([demandId])
  @@index([status])
}

model MarketplaceAgreement {
  id              String   @id @default(cuid())
  offerId         String   @unique
  opportunityId   String   @unique
  demandId        String
  supplyId        String
  providerId      String
  agreedPrice     Int
  supplierCompensation Int
  platformFee     Int
  status          String   @default("ACTIVE") // ACTIVE | COMPLETED | CANCELLED | BREACHED
  isMarketplaceOpportunity Boolean @default(true)
  researchStimulus Boolean  @default(false)
  environment     String   @default("SANDBOX")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  offer           MarketplaceOffer @relation(fields: [offerId], references: [id])
  opportunity     TransportationOpportunity @relation(fields: [opportunityId], references: [id])
  execution       TransportationExecution?
  paymentIntents  PaymentIntent[]

  @@index([opportunityId])
  @@index([status])
}

model TransportationExecution {
  id              String   @id @default(cuid())
  agreementId     String   @unique
  opportunityId   String   @unique
  demandId        String
  supplyId        String
  providerId      String
  state           String   @default("OPPORTUNITY_CREATED")
  environment     String   @default("SANDBOX")
  evidenceEligible Boolean @default(false) // false for SANDBOX/FIXTURE
  startedAt       DateTime?
  completedAt     DateTime?
  failureReason   String?
  isMarketplaceOpportunity Boolean @default(true)
  researchStimulus Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  opportunity     TransportationOpportunity @relation(fields: [opportunityId], references: [id])
  agreement       MarketplaceAgreement @relation(fields: [agreementId], references: [id])
  settlements     Settlement[]

  @@index([opportunityId])
  @@index([state])
  @@index([environment])
}

model MoneyAccount {
  id              String   @id @default(cuid())
  ownerId         String
  type            String   // customer | escrow | supplier | platform-revenue | platform-sandbox
  currency        String   @default("USD")
  balance         Int      @default(0) // integer minor units
  environment     String   @default("SANDBOX")
  frozen          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ledgerEntries   LedgerEntry[]

  @@index([ownerId])
  @@index([environment])
  @@unique([ownerId, type, environment, currency])
}

model LedgerEntry {
  id              String   @id @default(cuid())
  accountId       String
  type            String   // DEBIT | CREDIT
  amount          Int      // positive integer minor units
  currency        String   @default("USD")
  description     String
  referenceType   String   // demand | opportunity | agreement | execution | payment-intent | settlement | refund
  referenceId     String
  idempotencyKey  String   @unique
  pairedEntryId   String
  environment     String   @default("SANDBOX")
  timestamp       DateTime @default(now())

  account         MoneyAccount @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([referenceType, referenceId])
  @@index([environment])
}

model PaymentIntent {
  id              String   @id @default(cuid())
  demandId        String
  agreementId     String?
  executionId     String?
  customerId      String
  supplierId      String
  amount          Int
  userPrice       Int
  supplierCompensation Int
  platformFee     Int
  currency        String   @default("USD")
  status          String   @default("PENDING") // PENDING | AUTHORIZED | CAPTURED | RELEASED | REFUNDED | FAILED
  idempotencyKey  String   @unique
  authorizationId String?
  captureId       String?
  refundId        String?
  environment     String   @default("SANDBOX")
  createdAt       DateTime @default(now())
  capturedAt      DateTime?

  agreement       MarketplaceAgreement? @relation(fields: [agreementId], references: [id])

  @@index([demandId])
  @@index([agreementId])
  @@index([status])
}

model Settlement {
  id              String   @id @default(cuid())
  executionId     String
  supplierId      String
  amount          Int
  currency        String   @default("USD")
  status          String   @default("PENDING") // PENDING | SETTLED | FAILED
  idempotencyKey  String   @unique
  environment     String   @default("SANDBOX")
  settledAt       DateTime?
  createdAt       DateTime @default(now())

  execution       TransportationExecution @relation(fields: [executionId], references: [id])

  @@index([executionId])
  @@index([supplierId])
}

model AvailabilityBroadcast {
  id              String   @id @default(cuid())
  providerId      String
  resourceId      String
  currentLat      Float
  currentLon      Float
  destLat         Float
  destLon         Float
  departureStartSec Int
  departureEndSec Int
  availableCapacity Int
  detourToleranceKm Float
  minimumCompensation Int
  confidence      Float
  expiresAt       DateTime
  status          String   @default("POTENTIAL") // POTENTIAL | OFFERED | RESERVED | COMMITTED | EXPIRED
  isCommitted     Boolean  @default(false)
  environment     String   @default("SANDBOX")
  createdAt       DateTime @default(now())

  @@index([status])
  @@index([environment])
  @@index([providerId])
}

model MarketplaceEvent {
  id              String   @id @default(cuid())
  eventType       String   // demand-created | opportunity-discovered | offer-made | negotiation-started | agreement-signed | payment-authorized | execution-started | execution-completed
  referenceType   String   // demand | opportunity | offer | agreement | execution | payment | settlement
  referenceId     String
  environment     String   @default("SANDBOX")
  payloadJson     String?  // JSON
  timestamp       DateTime @default(now())

  @@index([referenceType, referenceId])
  @@index([environment])
  @@index([timestamp])
}

// Provider acceptance claim — durable idempotency record for external
// provider side effects. Created BEFORE the provider adapter is called.
// Guarantees at-most-once logical provider acceptance per offer.
model ProviderAcceptanceAttempt {
  id              String   @id @default(cuid())
  offerId         String
  providerId      String
  claimKey        String   @unique // stable idempotency key (derived from offerId + providerId)
  status          String   @default("PENDING") // PENDING | SUBMITTED | ACCEPTED | REJECTED | UNKNOWN | FAILED
  providerReference String? // provider's own reference/ID for this acceptance
  attemptCount    Int      @default(0)
  lastError       String?
  environment     String   @default("SANDBOX")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([offerId, providerId]) // one logical acceptance per offer
  @@index([offerId])
  @@index([providerId])
  @@index([status])
  @@index([environment])
}
