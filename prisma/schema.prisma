// ORYXX Prisma schema — PostgreSQL (Neon).
// Auth: User + Waitlist. Sessions are JWT (Credentials provider), so no
// Prisma adapter / Session model needed — keeps it lean. OAuth models can be
// added later without migration pain.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")      // pooled connection string (runtime)
  directUrl = env("DIRECT_URL")          // direct connection string (migrations)
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String? // null for future OAuth-only users
  role         String   @default("user") // user | admin | demo-rider | demo-driver | demo-shipper | demo-fleet
  status       String   @default("active") // active | suspended
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
}

model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      String   @default("user") // requested role at signup
  status    String   @default("pending") // pending | approved | rejected
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// Willingness field-experiment: stores real provider responses to pooled-trip
// offers. This produces W3 (revealed acceptance) and W4 (completed execution)
// evidence. Provider identity is pseudonymous (no PII).
// RESEARCH INTEGRITY: enrollment-bound, consent-enforced, immutable preregistration.

model AcceptanceExperiment {
  id              String   @id @default(cuid())
  name            String
  description     String
  status          String   @default("DRAFT") // DRAFT | PREREGISTERED | ACTIVE | COMPLETED | ABANDONED
  // safety constraints
  maxDetourKm     Float    @default(5.0)
  maxExtraTimeMin Float    @default(20.0)
  minCompensation Float    @default(1.0)
  // preregistration (immutable after ACTIVE)
  hypothesis      String?
  population      String?
  geography       String?
  providerType    String?
  sampleTarget    Int      @default(100)
  primaryOutcome  String   @default("W3_acceptance_rate")
  secondaryOutcomes String? // JSON array
  analysisMethod  String?
  stoppingRule    String?
  randomizationSeed Int   @default(42)
  preregistrationHash String? // SHA-256 of canonical design
  preregisteredAt String?
  // economic assumptions (labelled, not observed)
  assumedUserSavings Float @default(4.0)
  assumedFailureCost Float @default(1.0)
  assumedOryxxMargin Float @default(0.50)
  // consent
  requiresConsent Boolean  @default(true)
  consentText     String?
  consentVersion  Int      @default(1)
  // relations
  enrollments     ExperimentEnrollment[]
  responses       ProviderResponse[]
  events          ExperimentEvent[]
  consents        ExperimentConsent[]

  @@index([status])
}

// Enrollment: binds a pseudonymous participant to an experiment.
// The participantId is SERVER-GENERATED, never client-supplied.
model ExperimentEnrollment {
  id              String   @id @default(cuid())
  experimentId    String
  experiment      AcceptanceExperiment @relation(fields: [experimentId], references: [id])
  // server-generated pseudonymous ID (no PII)
  participantId   String   @unique
  // enrollment token (used for offer authorization)
  enrollmentToken String   @unique
  // treatment cell assigned at enrollment (immutable)
  assignedCellId  String?
  // timestamps
  enrolledAt      DateTime @default(now())
  withdrawnAt     DateTime?
  status          String   @default("active") // active | withdrawn
  // relations
  responses       ProviderResponse[]
  consents        ExperimentConsent[]

  @@index([experimentId])
  @@index([participantId])
}

// Consent: server-enforced prerequisite for participation.
// No response is accepted without a valid, non-withdrawn consent record.
model ExperimentConsent {
  id              String   @id @default(cuid())
  experimentId    String
  experiment      AcceptanceExperiment @relation(fields: [experimentId], references: [id])
  enrollmentId    String
  enrollment      ExperimentEnrollment @relation(fields: [enrollmentId], references: [id])
  participantId   String
  consentVersion  Int
  consentTextHash String   // hash of the consent text at time of consent
  consentText     String
  consentedAt     DateTime @default(now())
  withdrawnAt     DateTime?

  @@index([experimentId])
  @@index([enrollmentId])
}

model ProviderResponse {
  id              String   @id @default(cuid())
  experimentId    String
  experiment      AcceptanceExperiment @relation(fields: [experimentId], references: [id])
  // enrollment-bound: the response must belong to an enrolled participant
  enrollmentId    String
  enrollment      ExperimentEnrollment @relation(fields: [enrollmentId], references: [id])
  // server-derived from enrollment (NOT client-supplied)
  participantId   String
  // the offer
  treatmentCellId String
  compensation    Float
  detourKm        Float
  extraTimeMin    Float
  advanceNoticeMin Float
  passengerCount  Int      @default(1)
  tripDistanceKm   Float
  originName      String
  destName        String
  hourOfDay       Int
  // state machine
  state           String   @default("OFFER_CREATED")
  decision        String?  // accept | decline | not_available | ignore
  // execution
  executed        Boolean?
  completed       Boolean?
  executionFailureReason String?
  // evidence tier (computed from state, NOT from client)
  evidenceTier    String   @default("NONE")
  // timing
  offerPresentedAt String?
  offerExpiresAt  String?  // offer becomes PROVIDER_IGNORED after this
  providerViewedAt String?
  decisionAt      String?
  timestamp       DateTime @default(now())

  @@index([experimentId])
  @@index([enrollmentId])
  @@index([participantId])
  @@index([state])
  @@index([evidenceTier])
}

// Append-only event log: the scientific audit trail.
// Never updated, only inserted.
model ExperimentEvent {
  id              String   @id @default(cuid())
  experimentId    String
  experiment      AcceptanceExperiment @relation(fields: [experimentId], references: [id])
  offerId         String
  participantId   String
  fromState       String?  // null for initial creation
  toState         String
  timestamp       DateTime @default(now())
  actorType       String   // system | participant | admin
  actorId         String
  metadataHash    String

  @@index([experimentId])
  @@index([offerId])
}
