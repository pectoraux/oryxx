// ORYXX Prisma schema — PostgreSQL (Neon).
// Auth: User + Waitlist. Sessions are JWT (Credentials provider), so no
// Prisma adapter / Session model needed — keeps it lean. OAuth models can be
// added later without migration pain.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")      // pooled connection string (runtime)
  directUrl = env("DIRECT_URL")          // direct connection string (migrations)
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String? // null for future OAuth-only users
  role         String   @default("user") // user | admin | demo-rider | demo-driver | demo-shipper | demo-fleet
  status       String   @default("active") // active | suspended
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
}

model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      String   @default("user") // requested role at signup
  status    String   @default("pending") // pending | approved | rejected
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}
