// ORYXX Prisma schema — PostgreSQL (Neon).
// Auth: User + Waitlist. Sessions are JWT (Credentials provider), so no
// Prisma adapter / Session model needed — keeps it lean. OAuth models can be
// added later without migration pain.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")      // pooled connection string (runtime)
  directUrl = env("DIRECT_URL")          // direct connection string (migrations)
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String? // null for future OAuth-only users
  role         String   @default("user") // user | admin | demo-rider | demo-driver | demo-shipper | demo-fleet
  status       String   @default("active") // active | suspended
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
}

model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      String   @default("user") // requested role at signup
  status    String   @default("pending") // pending | approved | rejected
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// Willingness field-experiment: stores real provider responses to pooled-trip
// offers. This produces W3 (revealed acceptance) and W4 (completed execution)
// evidence — the critical gap in the ORYXX thesis. Provider identity is
// pseudonymous (no PII).
model AcceptanceExperiment {
  id          String   @id @default(cuid())
  name        String
  description String
  status      String   @default("preregistered") // preregistered | active | completed | abandoned
  maxDetourKm Float    @default(5.0)
  maxExtraTimeMin Float @default(20.0)
  minCompensation Float @default(1.0)
  requiresConsent Boolean @default(true)
  consentText String?
  // preregistration (immutable once active)
  hypothesis  String?
  sampleTarget Int    @default(100)
  primaryOutcome String @default("W3_acceptance_rate")
  stoppingRule String?
  randomizationSeed Int @default(42)
  isImmutable Boolean  @default(false)
  preregisteredAt String?
  responses   ProviderResponse[]

  @@index([status])
}

model ProviderResponse {
  id              String   @id @default(cuid())
  experimentId    String
  experiment      AcceptanceExperiment @relation(fields: [experimentId], references: [id])
  // pseudonymous provider ID (no PII)
  providerId      String
  // the offer presented
  compensation    Float
  detourKm        Float
  extraTimeMin    Float
  advanceNoticeMin Float
  passengerCount  Int      @default(1)
  tripDistanceKm   Float
  originName      String
  destName        String
  hourOfDay       Int
  // state machine
  state           String   @default("OFFER_CREATED") // see pilot.ts VALID_TRANSITIONS
  // decision
  decision        String?  // accept | decline | not_available | ignore (null until responded)
  // execution (if accepted)
  executed        Boolean?
  completed        Boolean?
  executionFailureReason String?
  // evidence tier (computed from state)
  evidenceTier    String   @default("W0") // W2a | W2b | W3 | W4
  // consent
  consentObtained Boolean  @default(false)
  // timing
  offerPresentedAt String?
  providerViewedAt String?
  decisionAt      String?
  timestamp       DateTime @default(now())

  @@index([experimentId])
  @@index([providerId])
  @@index([decision])
  @@index([state])
  @@index([evidenceTier])
}
